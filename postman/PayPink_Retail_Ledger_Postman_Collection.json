{
  "info": {
    "_postman_id": "8f3b2c1a-7d4e-4f9a-9e12-3b4c5d6e7f8a",
    "name": "PayPink Core Retail Ledger & Balance Mutation Engine",
    "description": "Comprehensive Postman Test Suite for FSE Capstone: Core Balance Mutation Engine, JSR-380 Validation, RFC-7807 Problem Details, Redis Idempotency (<5ms), Pessimistic Lock Double-Spend Prevention, and @Scheduled Reconciliation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Security (Perimeter Layer)",
      "item": [
        {
          "name": "POST Login & Generate JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"JWT token received\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jdelacruz\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "GET Quick Demo JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"jwt_token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/demo-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "demo-token"]
            }
          }
        }
      ]
    },
